APP_ENV=development
APP_SECRET_KEY=change-me-before-production
# Порт, на котором дэшборд слушает на хосте. Смените, если 8000 занят другим сервисом.
WEB_PORT=8000
DATABASE_URL=postgresql+psycopg://radar:radar@postgres:5432/radar
YOUTUBE_API_KEY=
YOUTUBE_REGION=RU
YOUTUBE_DEFAULT_LANGUAGE=ru

# Автопоиск по расписанию. Каждый поиск по теме ~100 единиц квоты YouTube
# (бесплатно 10 000/день), обновление метрик — дёшево. При большом числе тем
# увеличьте интервал поиска, чтобы уложиться в дневной лимит.
SCHEDULER_ENABLED=true
SEARCH_INTERVAL_HOURS=12
METRICS_INTERVAL_HOURS=6
# Как часто проверять watchlist-каналы на новые ролики (часы).
WATCHLIST_INTERVAL_HOURS=24

# Отсекать Shorts и слишком короткие клипы (секунды). 180 = убрать все Shorts.
MIN_DURATION_SECONDS=180
# Мягкий фильтр языка по метаданным видео (через запятую). Пусто = не фильтровать.
ALLOWED_LANGUAGES=ru,en

# OpenAI-совместимый ключ для генерации Content Pack (статья, карусель и т.д.).
AI_API_KEY=
# Модель генерации. По умолчанию gpt-4o-mini (дёшево, достаточно для черновика).
# Впишите другую модель, чтобы сравнить качество — код менять не нужно.
AI_MODEL=gpt-4o-mini
# Необязательно: свой OpenAI-совместимый endpoint (напр. прокси). Пусто = OpenAI.
AI_BASE_URL=
# Транскрипты через Apify (обходит блокировку IP, ~$0.001-0.004 за ролик).
# Токен: apify.com -> Settings -> Integrations -> API token. Пусто = не использовать.
APIFY_TOKEN=
APIFY_ACTOR=pintostudio~youtube-transcript-scraper

# Аудио-fallback (когда у видео нет субтитров).
WHISPER_FALLBACK=true
# Groq (дёшево, ~$0.04/час): WHISPER_MODEL=whisper-large-v3-turbo,
# TRANSCRIBE_BASE_URL=https://api.groq.com/openai/v1, TRANSCRIBE_API_KEY=gsk_...
# По умолчанию OpenAI whisper-1 (~$0.006/мин) через AI_API_KEY.
WHISPER_MODEL=whisper-1
TRANSCRIBE_API_KEY=
TRANSCRIBE_BASE_URL=

